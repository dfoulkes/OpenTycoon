[gd_resource type="Theme" load_steps=12 format=3]

; OpenTycoon inspector theme (R89): a cream "property card" on dark ink, original to this game.
; Palette: cream #F6EFDC, ink #262420, felt green #2E6B3F, loss red #B3261E, brass #D9A441,
; night navy #1C2633. Shared by the in-game UI and the menus.
; Type variations: CardHeader, CardTitle, Caption, Badge, MoneyPositive, MoneyNegative,
; HudPanel, HudLabel, HudPaused, HudBankrupt, FeedEntry, FeedResult, FeedMuted, AuctionStrip,
; SectionTitle.


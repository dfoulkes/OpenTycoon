; Engine configuration file.
; OpenTycoon client (Godot 4.7). See README.md and docs/architecture.md.

config_version=5

[application]

config/name="OpenTycoon"
config/description="London economic tycoon, 1930–2050."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/menus/new_game_menu.gd" id="1_newgame"]

[node name="NewGameMenu" type="PanelContainer"]
custom_minimum_size = Vector2(460, 0)
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_newgame")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "New Game"
horizontal_alignment = 1

[node name="EconomyRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="EconomyLabel" type="Label" parent="Margin/VBox/EconomyRow"]
custom_minimum_size = Vector2(90, 0)
layout_mode = 2
text = "Economy"

[node name="EconomyOption" type="OptionButton" parent="Margin/VBox/EconomyRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="FileRow" type="HBoxContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="FileLabel" type="Label" parent="Margin/VBox/FileRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "No file chosen"
text_overrun_behavior = 3

[node name="BrowseButton" type="Button" parent="Margin/VBox/FileRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Browse…"

[node name="SeedRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="SeedLabel" type="Label" parent="Margin/VBox/SeedRow"]
custom_minimum_size = Vector2(90, 0)
layout_mode = 2
text = "Seed"

[node name="SeedEdit" type="LineEdit" parent="Margin/VBox/SeedRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "a whole number"

[node name="RandomButton" type="Button" parent="Margin/VBox/SeedRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Random"

[node name="ButtonRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 16

[node name="BackButton" type="Button" parent="Margin/VBox/ButtonRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(140, 0)
layout_mode = 2
text = "Back"

[node name="StartButton" type="Button" parent="Margin/VBox/ButtonRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(140, 0)
layout_mode = 2
text = "Start"

[node name="FileDialog" type="FileDialog" parent="."]
unique_name_in_owner = true
title = "Open an economy file"
ok_button_text = "Open"
file_mode = 0
access = 2
filters = PackedStringArray("*.yaml, *.yml ; Economy YAML")

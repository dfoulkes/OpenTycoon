{
  "$defs": {
    "Class": {
      "description": "Social class (§8.1).",
      "oneOf": [
        {
          "const": "working",
          "description": "Working class.",
          "type": "string"
        },
        {
          "const": "middle",
          "description": "Middle class.",
          "type": "string"
        },
        {
          "const": "upper",
          "description": "Upper class.",
          "type": "string"
        }
      ]
    },
    "CutWindow": {
      "additionalProperties": false,
      "description": "One stretch of the day a power cut keeps the shops dark: `from` (inclusive) to `to`\n(exclusive), inside one day (it can't wrap midnight).",
      "properties": {
        "from": {
          "description": "The lights go out.",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "type": "string"
        },
        "to": {
          "description": "The lights come back on.",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "Effect": {
      "description": "An event effect. Tagged by `kind`.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Scale shoppers' demand (the chance a good is on their list) for `days` days. `target`\nis a good id or a group in `groups`; `class` limits it to one class. With no target it\napplies to every good.",
          "properties": {
            "class": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Class"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Only shoppers of this class."
            },
            "days": {
              "description": "How many in-game days it lasts.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "factor": {
              "description": "Multiplier on demand.",
              "type": "number"
            },
            "kind": {
              "const": "demand_multiplier",
              "type": "string"
            },
            "target": {
              "default": null,
              "description": "Good id or group name.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "factor",
            "days"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Cap tomorrow's order of the target goods at `share` of each shop's capacity (rationing).",
          "properties": {
            "days": {
              "description": "How many in-game days it lasts.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "supply_cap",
              "type": "string"
            },
            "share": {
              "description": "Share of `capacity_per_good` a shop may stock.",
              "type": "number"
            },
            "target": {
              "description": "Good id or group name.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "target",
            "share",
            "days"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Power cuts (the 1970s three-day week, R69): on the game day the event fires, every\nwalk-in shop is dark during each window, so nobody buys there. Shoppers wait for the\nlights and then choose again. It lasts that one day only: an event never shuts shops\nfor whole days, so the windows must leave some of day trade lit.",
          "properties": {
            "kind": {
              "const": "power_cut",
              "type": "string"
            },
            "windows": {
              "description": "When the lights are out, inside one day, not overlapping.",
              "items": {
                "$ref": "#/$defs/CutWindow"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "windows"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Every shop's price of every good is off by a random amount within `±spread` (Decimal\nDay's price confusion), drawn once when the event fires.",
          "properties": {
            "days": {
              "description": "How many in-game days it lasts.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "price_noise",
              "type": "string"
            },
            "spread": {
              "description": "Largest deviation, as a share of the price.",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "spread",
            "days"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Shops on these blocks draw `factor` × the footfall (their pull on shoppers) for `days`\ndays.",
          "properties": {
            "blocks": {
              "description": "Block ids.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "days": {
              "description": "How many in-game days it lasts.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "factor": {
              "description": "Multiplier on the shop's pull.",
              "type": "number"
            },
            "kind": {
              "const": "footfall",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "blocks",
            "factor",
            "days"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Move blocks to a new desirability tier (permanent).",
          "properties": {
            "blocks": {
              "description": "Block ids.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "kind": {
              "const": "desirability_change",
              "type": "string"
            },
            "tier": {
              "$ref": "#/$defs/Tier",
              "description": "New tier."
            }
          },
          "required": [
            "kind",
            "blocks",
            "tier"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Destroy buildings at random, with compensation paid by the city.",
          "properties": {
            "blocks": {
              "description": "Block ids at risk.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "chance": {
              "description": "Chance per building.",
              "type": "number"
            },
            "compensation": {
              "description": "Compensation as a share of property value.",
              "type": "number"
            },
            "kind": {
              "const": "destroy_buildings",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "blocks",
            "chance",
            "compensation"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Scale every lease's land value (its last auction price) once.",
          "properties": {
            "factor": {
              "description": "Multiplier.",
              "type": "number"
            },
            "kind": {
              "const": "land_value",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "factor"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Scale the property value (build cost) of every building of these types once.",
          "properties": {
            "factor": {
              "description": "Multiplier.",
              "type": "number"
            },
            "kind": {
              "const": "property_value",
              "type": "string"
            },
            "types": {
              "description": "Business type ids.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "types",
            "factor"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Move `share` of the unhoused adults of class `from` to class `to` (permanent).",
          "properties": {
            "from": {
              "$ref": "#/$defs/Class",
              "description": "From."
            },
            "kind": {
              "const": "class_shift",
              "type": "string"
            },
            "share": {
              "description": "Share moved.",
              "type": "number"
            },
            "to": {
              "$ref": "#/$defs/Class",
              "description": "To."
            }
          },
          "required": [
            "kind",
            "from",
            "to",
            "share"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Switch the currency display to decimal (a display flag only).",
          "properties": {
            "kind": {
              "const": "decimal_currency",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Headline only; no mechanical effect.",
          "properties": {
            "kind": {
              "const": "flavour",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "ElectionHeadlines": {
      "additionalProperties": false,
      "description": "Election headlines.",
      "properties": {
        "conservative": {
          "description": "Conservative win.",
          "type": "string"
        },
        "labour": {
          "description": "Labour win.",
          "type": "string"
        }
      },
      "required": [
        "labour",
        "conservative"
      ],
      "type": "object"
    },
    "ElectionSettings": {
      "additionalProperties": false,
      "description": "Elections (R12, §9.1).",
      "properties": {
        "enabled": {
          "description": "Whether every year step holds a general election.",
          "type": "boolean"
        },
        "headlines": {
          "$ref": "#/$defs/ElectionHeadlines",
          "default": {
            "conservative": "Conservatives Win the General Election",
            "labour": "Labour Win the General Election"
          },
          "description": "Front-page headlines per result."
        },
        "weights": {
          "additionalProperties": {
            "$ref": "#/$defs/PartyWeights"
          },
          "description": "Win weights per step year. Steps without an entry use the latest earlier one.",
          "type": "object"
        }
      },
      "required": [
        "enabled",
        "weights"
      ],
      "type": "object"
    },
    "EraEvent": {
      "additionalProperties": false,
      "description": "One event in the random pool.",
      "properties": {
        "effects": {
          "default": [],
          "description": "What it does.",
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "type": "array"
        },
        "headline": {
          "description": "Newspaper headline.",
          "type": "string"
        },
        "id": {
          "description": "Stable id.",
          "type": "string"
        },
        "weight": {
          "description": "Relative weight.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "headline",
        "weight"
      ],
      "type": "object"
    },
    "HistoricalEvent": {
      "additionalProperties": false,
      "description": "A historical event.",
      "properties": {
        "effects": {
          "default": [],
          "description": "What it does.",
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "type": "array"
        },
        "headline": {
          "description": "Newspaper headline. A power cut's headline names its hours with `{cut_windows}`\n([`CUT_WINDOWS`]), rendered from the windows when the paper comes out.",
          "type": "string"
        },
        "id": {
          "description": "Stable id.",
          "type": "string"
        },
        "year": {
          "description": "Historical year; fires on the step that covers it.",
          "format": "int32",
          "maximum": 2500,
          "minimum": 1800,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "year",
        "headline"
      ],
      "type": "object"
    },
    "IncidentEffect": {
      "description": "What a random per-building event does.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The building is destroyed.",
          "properties": {
            "kind": {
              "const": "destroy",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`share` of every good on the shelf is lost.",
          "properties": {
            "kind": {
              "const": "stock_loss",
              "type": "string"
            },
            "share": {
              "description": "Share lost.",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "share"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The owner pays the city a fine.",
          "properties": {
            "amount": {
              "description": "Amount.",
              "type": "number"
            },
            "kind": {
              "const": "fine",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "amount"
          ],
          "type": "object"
        }
      ]
    },
    "InsuranceSettings": {
      "additionalProperties": false,
      "description": "Insurance (§9: an optional product).",
      "properties": {
        "premium_rate": {
          "description": "Daily premium as a share of each insured building's property value, paid to the city at\n06:00.",
          "type": "number"
        }
      },
      "required": [
        "premium_rate"
      ],
      "type": "object"
    },
    "PartyWeights": {
      "additionalProperties": false,
      "description": "Election weights.",
      "properties": {
        "conservative": {
          "description": "Conservative (privatises utilities).",
          "type": "number"
        },
        "labour": {
          "description": "Labour (nationalises utilities).",
          "type": "number"
        }
      },
      "required": [
        "labour",
        "conservative"
      ],
      "type": "object"
    },
    "RandomEra": {
      "additionalProperties": false,
      "description": "Random front-page events (§9: 2030+).",
      "properties": {
        "chance_per_step": {
          "description": "Chance per year step that one fires.",
          "type": "number"
        },
        "events": {
          "description": "The pool; one is picked by weight.",
          "items": {
            "$ref": "#/$defs/EraEvent"
          },
          "type": "array"
        },
        "from_year": {
          "description": "First step year that can roll one.",
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "from_year",
        "chance_per_step",
        "events"
      ],
      "type": "object"
    },
    "RandomEvent": {
      "additionalProperties": false,
      "description": "A random per-building event.",
      "properties": {
        "daily_chance": {
          "description": "Chance per building per day.",
          "type": "number"
        },
        "effect": {
          "$ref": "#/$defs/IncidentEffect",
          "description": "What happens."
        },
        "id": {
          "description": "Stable id.",
          "type": "string"
        },
        "insured_payout": {
          "default": 0.0,
          "description": "Share of the loss an insured owner is paid back by the city (0: not insurable).",
          "type": "number"
        }
      },
      "required": [
        "id",
        "daily_chance",
        "effect"
      ],
      "type": "object"
    },
    "Tier": {
      "description": "Desirability tier (§4.1).",
      "oneOf": [
        {
          "const": "low",
          "description": "Low.",
          "type": "string"
        },
        {
          "const": "medium",
          "description": "Medium.",
          "type": "string"
        },
        {
          "const": "high",
          "description": "High.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Root of `events.yaml`.",
  "properties": {
    "elections": {
      "$ref": "#/$defs/ElectionSettings",
      "description": "General elections (§9.1)."
    },
    "groups": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "default": {},
      "description": "Named groups of goods that effects target (`luxury`, `staples`, ...). An effect's\n`target` is a group name or a single good id from `businesses.yaml`.",
      "type": "object"
    },
    "historical": {
      "description": "Fixed history. Each fires on the year step covering its year (§9).",
      "items": {
        "$ref": "#/$defs/HistoricalEvent"
      },
      "type": "array"
    },
    "insurance": {
      "$ref": "#/$defs/InsuranceSettings",
      "default": {
        "premium_rate": 0.0
      },
      "description": "Optional insurance against random events (§9)."
    },
    "random": {
      "description": "Per-building daily random events (§9: fire, burglary, inspection).",
      "items": {
        "$ref": "#/$defs/RandomEvent"
      },
      "type": "array"
    },
    "random_era": {
      "$ref": "#/$defs/RandomEra",
      "default": {
        "chance_per_step": 0.0,
        "events": [],
        "from_year": 0
      },
      "description": "Random front-page events from a year onwards (§9: 2030+)."
    }
  },
  "required": [
    "historical",
    "random",
    "elections"
  ],
  "title": "EventsConfig",
  "type": "object"
}

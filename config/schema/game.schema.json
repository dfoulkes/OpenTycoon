{
  "$defs": {
    "BankruptcySettings": {
      "additionalProperties": false,
      "description": "Bankruptcy (§2.3). The sell-back ratio is `economy.yaml` `money.sell_to_city_ratio` (R71).",
      "properties": {
        "solvent_at_or_above": {
          "description": "A midnight balance at or above this passes (R3, default £0).",
          "type": "number"
        },
        "strikes_to_bankrupt": {
          "description": "Consecutive failed midnights before bankruptcy (default 2).",
          "format": "uint32",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "strikes_to_bankrupt",
        "solvent_at_or_above"
      ],
      "type": "object"
    },
    "ClockSettings": {
      "additionalProperties": false,
      "description": "Game clock (R34).",
      "properties": {
        "end_year": {
          "description": "Final year: the game ends at the midnight the year reaches this (default 2050).",
          "format": "int32",
          "maximum": 2500,
          "minimum": 1800,
          "type": "integer"
        },
        "real_minutes_per_day": {
          "description": "Real minutes per in-game day (R34, default 20).",
          "format": "uint32",
          "maximum": 1440,
          "minimum": 1,
          "type": "integer"
        },
        "schedule": {
          "$ref": "#/$defs/DailySchedule",
          "description": "Fixed daily schedule points."
        },
        "start_year": {
          "description": "First in-game year (default 1930).",
          "format": "int32",
          "maximum": 2500,
          "minimum": 1800,
          "type": "integer"
        },
        "tick_game_seconds": {
          "description": "Game-seconds per simulation tick (§10a, default 10). Must divide 60.",
          "format": "uint32",
          "maximum": 60,
          "minimum": 1,
          "type": "integer"
        },
        "trading_hours": {
          "$ref": "#/$defs/TradingHours",
          "description": "Trading windows."
        },
        "years_per_day": {
          "description": "Years added at each midnight (R34, default 5).",
          "format": "uint32",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "real_minutes_per_day",
        "years_per_day",
        "start_year",
        "end_year",
        "tick_game_seconds",
        "trading_hours",
        "schedule"
      ],
      "type": "object"
    },
    "DailySchedule": {
      "additionalProperties": false,
      "description": "Fixed daily schedule (§2.2). Midnight reckoning is the day boundary and is not configurable.",
      "properties": {
        "arrivals": {
          "description": "New population arrives by train (R53, default 05:30).",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "type": "string"
        },
        "settlement": {
          "description": "Bills paid, stock arrives, population joins (default 06:00).",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "type": "string"
        }
      },
      "required": [
        "arrivals",
        "settlement"
      ],
      "type": "object"
    },
    "PlayerSettings": {
      "additionalProperties": false,
      "description": "Player seats (§1). Starting cash is `economy.yaml` `money.starting_cash` (R71).",
      "properties": {
        "max": {
          "description": "Most players in a game (default 6).",
          "format": "uint32",
          "maximum": 16,
          "minimum": 1,
          "type": "integer"
        },
        "min": {
          "description": "Fewest players in a game (default 2).",
          "format": "uint32",
          "maximum": 16,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "type": "object"
    },
    "Preset": {
      "additionalProperties": false,
      "description": "A game length preset (§2.4).",
      "properties": {
        "end_year": {
          "description": "Final year.",
          "format": "int32",
          "maximum": 2500,
          "minimum": 1800,
          "type": "integer"
        },
        "start_year": {
          "description": "First year.",
          "format": "int32",
          "maximum": 2500,
          "minimum": 1800,
          "type": "integer"
        }
      },
      "required": [
        "start_year",
        "end_year"
      ],
      "type": "object"
    },
    "TradingHours": {
      "additionalProperties": false,
      "description": "Trading windows (R1, R30). Open is inclusive, close is exclusive; a window may wrap midnight.",
      "properties": {
        "day": {
          "$ref": "#/$defs/Window",
          "description": "Day trade (default 07:00–17:00)."
        },
        "hotel": {
          "$ref": "#/$defs/Window",
          "description": "Hotel rooms (default 23:30–03:00, wraps midnight)."
        },
        "night": {
          "$ref": "#/$defs/Window",
          "description": "Night trade (default 19:00–23:50)."
        }
      },
      "required": [
        "day",
        "night",
        "hotel"
      ],
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "description": "One trading window.",
      "properties": {
        "close": {
          "description": "Closing time (exclusive).",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "type": "string"
        },
        "open": {
          "description": "Opening time (inclusive).",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "type": "string"
        }
      },
      "required": [
        "open",
        "close"
      ],
      "type": "object"
    },
    "WorldSettings": {
      "additionalProperties": false,
      "description": "World geometry (§4.1, R48, R57).",
      "properties": {
        "lot_size": {
          "description": "Lot size in units, `[width, depth]` (R22, default 9×9).",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "max_height": {
          "description": "Global building height cap in units (default 100). Per-type caps may not exceed it (R58).",
          "format": "uint32",
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "metres_per_lot_unit": {
          "description": "Metres per lot unit (R48, default 4).",
          "format": "uint32",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "metres_per_lot_unit",
        "lot_size",
        "max_height"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Root of `game.yaml`.",
  "properties": {
    "bankruptcy": {
      "$ref": "#/$defs/BankruptcySettings",
      "description": "Bankruptcy (§2.3; R3, R4)."
    },
    "clock": {
      "$ref": "#/$defs/ClockSettings",
      "description": "Game clock (R34) and trading hours (R1, R30)."
    },
    "players": {
      "$ref": "#/$defs/PlayerSettings",
      "description": "Player seats."
    },
    "presets": {
      "additionalProperties": {
        "$ref": "#/$defs/Preset"
      },
      "description": "Game length presets (§2.4), keyed by name.",
      "type": "object"
    },
    "world": {
      "$ref": "#/$defs/WorldSettings",
      "description": "World geometry."
    }
  },
  "required": [
    "world",
    "clock",
    "presets",
    "bankruptcy",
    "players"
  ],
  "title": "GameConfig",
  "type": "object"
}

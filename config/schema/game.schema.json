{
  "$defs": {
    "BankruptcySettings": {
      "additionalProperties": false,
      "description": "Bankruptcy and selling up (§2.3).",
      "properties": {
        "sell_to_city_ratio": {
          "description": "Instant sale back to the city, as a share of true value (R5, default 0.5).",
          "type": "number"
        },
        "solvent_at_or_above": {
          "description": "A midnight balance at or above this passes (R3, default £0).",
          "type": "number"
        },
        "strikes_to_bankrupt": {
          "description": "Consecutive failed midnights before bankruptcy (default 2).",
          "format": "uint32",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "strikes_to_bankrupt",
        "solvent_at_or_above",
        "sell_to_city_ratio"
      ],
      "type": "object"
    },
    "ClockSettings": {
      "additionalProperties": false,
      "description": "Game clock (R34).",
      "properties": {
        "end_year": {
          "description": "Final year: the game ends at the midnight the year reaches this (default 2050).",
          "format": "int32",
          "maximum": 2500,
          "minimum": 1800,
          "type": "integer"
        },
        "real_minutes_per_day": {
          "description": "Real minutes per in-game day (R34, default 20).",
          "format": "uint32",
          "maximum": 1440,
          "minimum": 1,
          "type": "integer"
        },
        "schedule": {
          "$ref": "#/$defs/DailySchedule",
          "description": "Fixed daily schedule points."
        },
        "start_year": {
          "description": "First in-game year (default 1930).",
          "format": "int32",
          "maximum": 2500,
          "minimum": 1800,
          "type": "integer"
        },
        "tick_game_seconds": {
          "description": "Game-seconds per simulation tick (§10a, default 10). Must divide 60.",
          "format": "uint32",
          "maximum": 60,
          "minimum": 1,
          "type": "integer"
        },
        "trading_hours": {
          "$ref": "#/$defs/TradingHours",
          "description": "Trading windows."
        },
        "years_per_day": {
          "description": "Years added at each midnight (R34, default 5).",
          "format": "uint32",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "real_minutes_per_day",
        "years_per_day",
        "start_year",
        "end_year",
        "tick_game_seconds",
        "trading_hours",
        "schedule"
      ],
      "type": "object"
    },
    "DailySchedule": {
      "additionalProperties": false,
      "description": "Fixed daily schedule (§2.2). Midnight reckoning is the day boundary and is not configurable.",
      "properties": {
        "arrivals": {
          "description": "New population arrives by train (R53, default 05:30).",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "type": "string"
        },
        "settlement": {
          "description": "Bills paid, stock arrives, population joins (default 06:00).",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "type": "string"
        }
      },
      "required": [
        "arrivals",
        "settlement"
      ],
      "type": "object"
    },
    "LandValueMethod": {
      "description": "How a held lease's land counts towards net worth (§3). The spec's formula is\n`book_decay`; the others are balance-study candidates (docs/economy.md \"Land value\").",
      "oneOf": [
        {
          "const": "book_decay",
          "description": "`last auction price × remaining lease years / term` (§3, the default).",
          "type": "string"
        },
        {
          "const": "market",
          "description": "`current land base price × remaining lease years / term`: the block's price today\n(moved by desirability shifts and land-value events such as the 2008 crash).",
          "type": "string"
        },
        {
          "const": "market_no_decay",
          "description": "`current land base price` while the lease runs, nothing once it has run out.",
          "type": "string"
        }
      ]
    },
    "LeaseSettings": {
      "additionalProperties": false,
      "description": "Land leases (§5.2).",
      "properties": {
        "term_years": {
          "description": "Lease length in in-game years (default 30).",
          "format": "uint32",
          "maximum": 500,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "term_years"
      ],
      "type": "object"
    },
    "NetWorthSettings": {
      "additionalProperties": false,
      "description": "Net worth scoring (R19, R39).",
      "properties": {
        "land_value": {
          "$ref": "#/$defs/LandValueMethod",
          "description": "How a held lease's land is valued (§3; docs/economy.md \"Land value\"). Default\n`book_decay`, the spec's `last auction price × years left / term`."
        },
        "lot_property_uplift": {
          "description": "Share of every property's value credited to the lot's leaseholder (R39, default 0.2).",
          "type": "number"
        }
      },
      "required": [
        "lot_property_uplift",
        "land_value"
      ],
      "type": "object"
    },
    "OverdraftSettings": {
      "additionalProperties": false,
      "description": "Overdraft (R7, R32).",
      "properties": {
        "increase_per_step": {
          "description": "Flat increase per 5-year step (default £2,500).",
          "type": "number"
        },
        "interest_rate": {
          "description": "Daily interest on overdrawn balances (default 0: R32 says none).",
          "type": "number"
        },
        "start_limit": {
          "description": "Credit limit at the start (default £10,000).",
          "type": "number"
        }
      },
      "required": [
        "start_limit",
        "increase_per_step",
        "interest_rate"
      ],
      "type": "object"
    },
    "PlayerSettings": {
      "additionalProperties": false,
      "description": "Player seats (§1).",
      "properties": {
        "max": {
          "description": "Most players in a game (default 6).",
          "format": "uint32",
          "maximum": 16,
          "minimum": 1,
          "type": "integer"
        },
        "min": {
          "description": "Fewest players in a game (default 2).",
          "format": "uint32",
          "maximum": 16,
          "minimum": 1,
          "type": "integer"
        },
        "starting_cash": {
          "description": "Cash each player starts with. Not in the spec; placeholder £0 (players start on the\noverdraft, R7).",
          "type": "number"
        }
      },
      "required": [
        "min",
        "max",
        "starting_cash"
      ],
      "type": "object"
    },
    "Preset": {
      "additionalProperties": false,
      "description": "A game length preset (§2.4).",
      "properties": {
        "end_year": {
          "description": "Final year.",
          "format": "int32",
          "maximum": 2500,
          "minimum": 1800,
          "type": "integer"
        },
        "start_year": {
          "description": "First year.",
          "format": "int32",
          "maximum": 2500,
          "minimum": 1800,
          "type": "integer"
        }
      },
      "required": [
        "start_year",
        "end_year"
      ],
      "type": "object"
    },
    "TradingHours": {
      "additionalProperties": false,
      "description": "Trading windows (R1, R30). Open is inclusive, close is exclusive; a window may wrap midnight.",
      "properties": {
        "day": {
          "$ref": "#/$defs/Window",
          "description": "Day trade (default 07:00–17:00)."
        },
        "hotel": {
          "$ref": "#/$defs/Window",
          "description": "Hotel rooms (default 23:30–03:00, wraps midnight)."
        },
        "night": {
          "$ref": "#/$defs/Window",
          "description": "Night trade (default 19:00–23:50)."
        }
      },
      "required": [
        "day",
        "night",
        "hotel"
      ],
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "description": "One trading window.",
      "properties": {
        "close": {
          "description": "Closing time (exclusive).",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "type": "string"
        },
        "open": {
          "description": "Opening time (inclusive).",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "type": "string"
        }
      },
      "required": [
        "open",
        "close"
      ],
      "type": "object"
    },
    "WorldSettings": {
      "additionalProperties": false,
      "description": "World geometry (§4.1, R48, R57).",
      "properties": {
        "lot_size": {
          "description": "Lot size in units, `[width, depth]` (R22, default 9×9).",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "max_height": {
          "description": "Global building height cap in units (default 100). Per-type caps may not exceed it (R58).",
          "format": "uint32",
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "metres_per_lot_unit": {
          "description": "Metres per lot unit (R48, default 4).",
          "format": "uint32",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "metres_per_lot_unit",
        "lot_size",
        "max_height"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Root of `game.yaml`.",
  "properties": {
    "bankruptcy": {
      "$ref": "#/$defs/BankruptcySettings",
      "description": "Bankruptcy and selling up (§2.3; R3, R4, R5)."
    },
    "clock": {
      "$ref": "#/$defs/ClockSettings",
      "description": "Game clock (R34) and trading hours (R1, R30)."
    },
    "leases": {
      "$ref": "#/$defs/LeaseSettings",
      "description": "Land leases (§5.2)."
    },
    "net_worth": {
      "$ref": "#/$defs/NetWorthSettings",
      "description": "Net worth scoring (R19, R39)."
    },
    "overdraft": {
      "$ref": "#/$defs/OverdraftSettings",
      "description": "Overdraft (R7, R32)."
    },
    "players": {
      "$ref": "#/$defs/PlayerSettings",
      "description": "Player seats."
    },
    "presets": {
      "additionalProperties": {
        "$ref": "#/$defs/Preset"
      },
      "description": "Game length presets (§2.4), keyed by name.",
      "type": "object"
    },
    "world": {
      "$ref": "#/$defs/WorldSettings",
      "description": "World geometry."
    }
  },
  "required": [
    "world",
    "clock",
    "presets",
    "bankruptcy",
    "overdraft",
    "net_worth",
    "leases",
    "players"
  ],
  "title": "GameConfig",
  "type": "object"
}

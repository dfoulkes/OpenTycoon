{
  "$defs": {
    "BusinessType": {
      "additionalProperties": false,
      "description": "A business type (§7.1).",
      "properties": {
        "channel": {
          "$ref": "#/$defs/Channel",
          "default": "shop",
          "description": "Walk-in shop (the default), online seller or infrastructure (§7.5)."
        },
        "goods": {
          "description": "Good ids it sells. Multi-good stores split capacity.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "hours": {
          "$ref": "#/$defs/Hours",
          "description": "When it trades."
        },
        "max_height": {
          "description": "Maximum height in units: `1 ≤ max_height ≤ world.max_height` (R58).",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "min_footprint": {
          "description": "Minimum `[width, depth]` footprint within the lot.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        },
        "obsolete_year": {
          "description": "Optional year after which demand fades: shoppers favour other shops (§7.1).",
          "format": "int32",
          "maximum": 2500,
          "minimum": 1800,
          "type": [
            "integer",
            "null"
          ]
        },
        "stock_density": {
          "description": "Units of stock per unit of building volume (R10).",
          "type": "number"
        },
        "unlock_year": {
          "description": "First year it can be built.",
          "format": "int32",
          "maximum": 2500,
          "minimum": 1800,
          "type": "integer"
        },
        "utility_factor": {
          "$ref": "#/$defs/UtilityFactors",
          "description": "Multipliers on the utility base rates."
        }
      },
      "required": [
        "name",
        "min_footprint",
        "max_height",
        "stock_density",
        "hours",
        "goods",
        "utility_factor",
        "unlock_year"
      ],
      "type": "object"
    },
    "Channel": {
      "description": "How a business reaches its customers (§7.5).",
      "oneOf": [
        {
          "const": "shop",
          "description": "A walk-in shop: shoppers walk to its door (§8.3).",
          "type": "string"
        },
        {
          "const": "online",
          "description": "An online seller (§7.5, R15, R36): no walk-in trade; its demand model is e-commerce's.",
          "type": "string"
        },
        {
          "const": "infrastructure",
          "description": "Infrastructure (data centre, lockers, farms, hubs): no walk-in trade.",
          "type": "string"
        }
      ]
    },
    "FitOut": {
      "additionalProperties": false,
      "description": "One fit-out level.",
      "properties": {
        "appeal": {
          "description": "Multiplier on class affinity when customers score the shop (§8.3).",
          "type": "number"
        },
        "build_cost_mult": {
          "description": "Multiplier on build cost.",
          "type": "number"
        }
      },
      "required": [
        "build_cost_mult",
        "appeal"
      ],
      "type": "object"
    },
    "FitOutTable": {
      "additionalProperties": false,
      "description": "Fit-out levels.",
      "properties": {
        "high": {
          "$ref": "#/$defs/FitOut",
          "description": "High."
        },
        "low": {
          "$ref": "#/$defs/FitOut",
          "description": "Low."
        },
        "medium": {
          "$ref": "#/$defs/FitOut",
          "description": "Medium."
        }
      },
      "required": [
        "low",
        "medium",
        "high"
      ],
      "type": "object"
    },
    "Good": {
      "additionalProperties": false,
      "description": "A good on sale.",
      "properties": {
        "luxury": {
          "default": false,
          "description": "Luxury goods get a mild boost from a higher price (§8.3).",
          "type": "boolean"
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        },
        "obsolete_year": {
          "description": "Year after which demand for it fades (§7.1); absent means never.",
          "format": "int32",
          "maximum": 2500,
          "minimum": 1800,
          "type": [
            "integer",
            "null"
          ]
        },
        "purchase_price": {
          "description": "Wholesale price per unit paid at the 06:00 settlement.",
          "type": "number"
        },
        "ref_price": {
          "description": "Reference retail price per unit (`ref_price` in §8.3).",
          "type": "number"
        },
        "unlock_year": {
          "description": "First year anyone wants it; absent means from the start (§7.4).",
          "format": "int32",
          "maximum": 2500,
          "minimum": 1800,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "ref_price",
        "purchase_price"
      ],
      "type": "object"
    },
    "HotelSettings": {
      "additionalProperties": false,
      "description": "The Hotel (§7.3): which type it is and how its rooms are counted (R14, R29, R30).",
      "properties": {
        "building_type": {
          "description": "The business type id that is a Hotel. It trades in the hotel window (`hours: hotel`),\nholds no stock (`stock_density: 0`) and sells one good, the room night, whose\n`ref_price` is the reference room price (R30).",
          "type": "string"
        },
        "room_size": {
          "description": "Units of building volume per room: `rooms = volume ÷ room_size` (R30, like flats, R50).",
          "format": "uint32",
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "building_type",
        "room_size"
      ],
      "type": "object"
    },
    "Hours": {
      "description": "When a business trades (§2.2, §7.1).",
      "oneOf": [
        {
          "const": "day",
          "description": "Day trade (R1).",
          "type": "string"
        },
        {
          "const": "night",
          "description": "Night trade (R1).",
          "type": "string"
        },
        {
          "const": "hotel",
          "description": "Hotel rooms, 23:30–03:00 (R30).",
          "type": "string"
        },
        {
          "const": "none",
          "description": "Never trades (apartments).",
          "type": "string"
        }
      ]
    },
    "ReferenceShop": {
      "additionalProperties": false,
      "description": "The reference shop of the business-stats formula (docs/economy.md \"Business stats\"): a\nbuilding of the type's `min_footprint`, `height` high, on a Medium-tier block, selling\n`sell_through` of its stock at reference prices. Its stock density is set so that this shop\ncovers its rent and utilities and earns its build cost back in `payback_days`.",
      "properties": {
        "height": {
          "description": "Height of the reference building, in units.",
          "format": "uint32",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "payback_days": {
          "description": "Days for a Medium-tier reference shop to earn back its build cost.",
          "format": "uint32",
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "sell_through": {
          "description": "Share of its stock a competently run shop sells in a day (the reference footfall).\nAbove 0 and at most 1.",
          "type": "number"
        }
      },
      "required": [
        "height",
        "sell_through",
        "payback_days"
      ],
      "type": "object"
    },
    "UtilityFactors": {
      "additionalProperties": false,
      "description": "Utility multipliers for a business type.",
      "properties": {
        "electricity": {
          "description": "Electricity.",
          "type": "number"
        },
        "gas": {
          "description": "Gas.",
          "type": "number"
        },
        "telecoms": {
          "description": "Telecoms / internet.",
          "type": "number"
        },
        "water": {
          "description": "Water.",
          "type": "number"
        }
      },
      "required": [
        "electricity",
        "gas",
        "water",
        "telecoms"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Root of `businesses.yaml`.",
  "properties": {
    "build_base_rate": {
      "description": "Build cost per unit of building volume, before the tier multiplier (§5.3).",
      "type": "number"
    },
    "fit_out": {
      "$ref": "#/$defs/FitOutTable",
      "description": "Fit-out levels (§7.1)."
    },
    "goods": {
      "additionalProperties": {
        "$ref": "#/$defs/Good"
      },
      "description": "Goods catalogue, keyed by good id.",
      "type": "object"
    },
    "hotel": {
      "$ref": "#/$defs/HotelSettings",
      "description": "The Hotel (§7.3; R14, R29, R30)."
    },
    "reference": {
      "$ref": "#/$defs/ReferenceShop",
      "description": "The reference shop the stats formula is built around (docs/economy.md)."
    },
    "types": {
      "additionalProperties": {
        "$ref": "#/$defs/BusinessType"
      },
      "description": "Business types, keyed by type id.",
      "type": "object"
    }
  },
  "required": [
    "build_base_rate",
    "fit_out",
    "reference",
    "goods",
    "types",
    "hotel"
  ],
  "title": "BusinessesConfig",
  "type": "object"
}

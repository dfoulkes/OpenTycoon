{
  "$defs": {
    "BlockKind": {
      "description": "What a block is (§4.1).",
      "oneOf": [
        {
          "const": "buildable",
          "description": "Leasable and buildable.",
          "type": "string"
        },
        {
          "const": "utility",
          "description": "A utility block, auctioned like land (R12, R24).",
          "type": "string"
        },
        {
          "const": "special",
          "description": "Non-buildable (City Hall).",
          "type": "string"
        }
      ]
    },
    "BlockSettings": {
      "additionalProperties": false,
      "description": "One block (lot) on the grid.",
      "properties": {
        "col": {
          "description": "Column, 0-based from the left.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "description": "Stable id, `snake_case`.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/BlockKind",
          "description": "What the block is."
        },
        "land_base_price": {
          "description": "Minimum opening bid at auction (R23). Required for buildable blocks.",
          "type": [
            "number",
            "null"
          ]
        },
        "name": {
          "description": "District name shown to players.",
          "type": "string"
        },
        "row": {
          "description": "Row, 0-based from the top.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "set": {
          "description": "Colour set id, for buildable blocks.",
          "type": [
            "string",
            "null"
          ]
        },
        "tier": {
          "$ref": "#/$defs/Tier",
          "description": "Desirability tier."
        },
        "utility": {
          "$ref": "#/$defs/UtilitySite",
          "description": "Which utility stands here. Required on utility blocks, refused on any other."
        }
      },
      "required": [
        "id",
        "name",
        "row",
        "col",
        "tier",
        "kind"
      ],
      "type": "object"
    },
    "Board": {
      "additionalProperties": false,
      "description": "One board in `map.yaml`: its geography.",
      "properties": {
        "blocks": {
          "description": "Every block on the grid, exactly one per cell.",
          "items": {
            "$ref": "#/$defs/BlockSettings"
          },
          "type": "array"
        },
        "city_apartments": {
          "$ref": "#/$defs/CityApartments",
          "description": "The city's starting apartment blocks: one in each Low-tier set (R28)."
        },
        "desirability_shifts": {
          "default": [],
          "description": "Desirability shifts over the years (§4.2, R16), applied at the midnight year step.",
          "items": {
            "$ref": "#/$defs/DesirabilityShift"
          },
          "type": "array"
        },
        "grid": {
          "$ref": "#/$defs/GridSettings",
          "description": "Grid size in blocks."
        },
        "river": {
          "$ref": "#/$defs/River",
          "description": "The river running between two rows, crossed only at bridges (§4.1). None: no river."
        },
        "sets": {
          "additionalProperties": {
            "$ref": "#/$defs/SetSettings"
          },
          "description": "Colour sets (R14, R26), keyed by set id.",
          "type": "object"
        },
        "tube_stations": {
          "description": "Tube stations: spawn and despawn points (§4.3, R25).",
          "items": {
            "$ref": "#/$defs/TubeStation"
          },
          "type": "array"
        }
      },
      "required": [
        "grid",
        "sets",
        "blocks",
        "tube_stations",
        "city_apartments"
      ],
      "type": "object"
    },
    "Boards": {
      "additionalProperties": false,
      "description": "The boards in `map.yaml`, by name. A file needs only the board it selects; the shipped file\ncarries both.",
      "properties": {
        "full": {
          "$ref": "#/$defs/Board",
          "description": "The full 9×9 board (R26)."
        },
        "v1": {
          "$ref": "#/$defs/Board",
          "description": "The grey-box 3×3 test map."
        }
      },
      "type": "object"
    },
    "CityApartmentSite": {
      "additionalProperties": false,
      "description": "One city apartment block (R28).",
      "properties": {
        "block": {
          "description": "Block id it stands on; must be in a Low-tier set.",
          "type": "string"
        },
        "height": {
          "description": "Height in units (at most the business type's `max_height`, R58).",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "position": {
          "description": "`[x, y]` of the near corner inside the lot.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "size": {
          "description": "`[width, depth]` footprint; must touch the lot edge (R22).",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "block",
        "position",
        "size",
        "height"
      ],
      "type": "object"
    },
    "CityApartments": {
      "additionalProperties": false,
      "description": "The apartment blocks the city owns at the start of the game (R28).",
      "properties": {
        "business_type": {
          "description": "Business type id in `businesses.yaml` the blocks are built as.",
          "type": "string"
        },
        "sites": {
          "description": "Where each block stands: exactly one per Low-tier set.",
          "items": {
            "$ref": "#/$defs/CityApartmentSite"
          },
          "type": "array"
        }
      },
      "required": [
        "business_type",
        "sites"
      ],
      "type": "object"
    },
    "ColourBand": {
      "description": "Colour band, cheapest to dearest (§4.1, R26).",
      "oneOf": [
        {
          "const": "brown",
          "description": "Brown.",
          "type": "string"
        },
        {
          "const": "light_blue",
          "description": "Light blue.",
          "type": "string"
        },
        {
          "const": "pink",
          "description": "Pink.",
          "type": "string"
        },
        {
          "const": "orange",
          "description": "Orange.",
          "type": "string"
        },
        {
          "const": "red",
          "description": "Red.",
          "type": "string"
        },
        {
          "const": "yellow",
          "description": "Yellow.",
          "type": "string"
        },
        {
          "const": "green",
          "description": "Green.",
          "type": "string"
        },
        {
          "const": "dark_blue",
          "description": "Dark blue.",
          "type": "string"
        }
      ]
    },
    "DesirabilityShift": {
      "additionalProperties": false,
      "description": "A district's desirability shift (§4.2, R16): from `year` the block is `tier` and its\nminimum opening bid is `land_base_price` (R23: the price tracks desirability). Applied at\nthe first midnight year step that reaches `year`.",
      "properties": {
        "block": {
          "description": "Block id.",
          "type": "string"
        },
        "headline": {
          "description": "Front-page headline announcing the shift on the year step (§4.2).",
          "type": "string"
        },
        "land_base_price": {
          "description": "The new minimum opening bid (R23).",
          "type": "number"
        },
        "tier": {
          "$ref": "#/$defs/Tier",
          "description": "The new tier."
        },
        "year": {
          "description": "First year of the new tier.",
          "format": "int32",
          "maximum": 2500,
          "minimum": 1800,
          "type": "integer"
        }
      },
      "required": [
        "block",
        "year",
        "tier",
        "land_base_price",
        "headline"
      ],
      "type": "object"
    },
    "GridSettings": {
      "additionalProperties": false,
      "description": "Grid size in blocks (§4.1: 9×9 for the full game).",
      "properties": {
        "height": {
          "description": "Rows.",
          "format": "uint32",
          "maximum": 32,
          "minimum": 1,
          "type": "integer"
        },
        "width": {
          "description": "Columns.",
          "format": "uint32",
          "maximum": 32,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "MapChoice": {
      "description": "Which board a game is played on (R26).",
      "oneOf": [
        {
          "const": "v1",
          "description": "The grey-box 3×3 test map (§10c, §11).",
          "type": "string"
        },
        {
          "const": "full",
          "description": "The full 9×9 board: 26 colour sets, 4 utilities and City Hall (§4.1, R26).",
          "type": "string"
        }
      ]
    },
    "River": {
      "additionalProperties": false,
      "description": "A river between two rows of blocks, crossed by road only at bridges (§4.1: \"the Thames runs\nbetween rows as a gap with bridges, not as a row of blocks\").",
      "properties": {
        "bridges": {
          "description": "Columns with a bridge over it. A board split by a river needs at least one.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        },
        "south_of_row": {
          "description": "The river runs along the south edge of this row (0-based), so between it and the next.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "south_of_row",
        "bridges"
      ],
      "type": "object"
    },
    "SetSettings": {
      "additionalProperties": false,
      "description": "A colour set (R14, R26).",
      "properties": {
        "band": {
          "$ref": "#/$defs/ColourBand",
          "description": "Colour band, cheapest to dearest."
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "band"
      ],
      "type": "object"
    },
    "Tier": {
      "description": "Desirability tier (§4.1).",
      "oneOf": [
        {
          "const": "low",
          "description": "Low.",
          "type": "string"
        },
        {
          "const": "medium",
          "description": "Medium.",
          "type": "string"
        },
        {
          "const": "high",
          "description": "High.",
          "type": "string"
        }
      ]
    },
    "TierSettings": {
      "additionalProperties": false,
      "description": "Settings for one desirability tier.",
      "properties": {
        "desirability_mult": {
          "description": "`desirability_mult(tier)` in the rent and build-cost formulas (§5.3; 0.6 / 1.0 / 1.8).",
          "type": "number"
        }
      },
      "required": [
        "desirability_mult"
      ],
      "type": "object"
    },
    "TierTable": {
      "additionalProperties": false,
      "description": "Settings per desirability tier.",
      "properties": {
        "high": {
          "$ref": "#/$defs/TierSettings",
          "description": "High tier."
        },
        "low": {
          "$ref": "#/$defs/TierSettings",
          "description": "Low tier."
        },
        "medium": {
          "$ref": "#/$defs/TierSettings",
          "description": "Medium tier."
        }
      },
      "required": [
        "low",
        "medium",
        "high"
      ],
      "type": "object"
    },
    "TubeLine": {
      "additionalProperties": false,
      "description": "One tube line (§4.3).",
      "properties": {
        "footfall_weight": {
          "description": "Footfall weight each of its open stations adds to the block it sits on: customers\narrive at a station block in proportion to the sum over its open lines.",
          "format": "uint32",
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "footfall_weight"
      ],
      "type": "object"
    },
    "TubeStation": {
      "additionalProperties": false,
      "description": "A tube station sitting on a block (§4.3).",
      "properties": {
        "block": {
          "description": "Block id the station sits on.",
          "type": "string"
        },
        "line": {
          "description": "Line id: a key of `tube_lines`.",
          "type": "string"
        },
        "opens": {
          "description": "Year the line opens at this station.",
          "format": "int32",
          "maximum": 2500,
          "minimum": 1800,
          "type": "integer"
        }
      },
      "required": [
        "block",
        "line",
        "opens"
      ],
      "type": "object"
    },
    "UtilitySite": {
      "description": "The utility a utility block holds (§6, R24). Not a set.",
      "oneOf": [
        {
          "const": "electricity",
          "description": "Electricity.",
          "type": "string"
        },
        {
          "const": "gas",
          "description": "Gas.",
          "type": "string"
        },
        {
          "const": "water",
          "description": "Water.",
          "type": "string"
        },
        {
          "const": "telecoms",
          "description": "Telephone exchange, the internet from 1995 (R11).",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Root of `map.yaml`.",
  "properties": {
    "boards": {
      "$ref": "#/$defs/Boards",
      "description": "Every board, keyed by name."
    },
    "map": {
      "$ref": "#/$defs/MapChoice",
      "description": "The board this game is played on: a key of `boards`."
    },
    "tiers": {
      "$ref": "#/$defs/TierTable",
      "description": "Per-tier multipliers (§5.3), shared by every board."
    },
    "tube_lines": {
      "additionalProperties": {
        "$ref": "#/$defs/TubeLine"
      },
      "description": "Tube lines by id, shared by every board (§4.3).",
      "type": "object"
    }
  },
  "required": [
    "map",
    "tiers",
    "tube_lines",
    "boards"
  ],
  "title": "MapFile",
  "type": "object"
}

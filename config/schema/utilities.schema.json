{
  "$defs": {
    "InternetSettings": {
      "additionalProperties": false,
      "description": "The internet upgrade (R11, R15, R36).",
      "properties": {
        "upgrade_year": {
          "description": "Year the telephone exchange becomes the internet (default 1995). From then telecoms\nbills use `economy.yaml` `utilities.internet_base_rate`.",
          "format": "int32",
          "maximum": 2500,
          "minimum": 1800,
          "type": "integer"
        }
      },
      "required": [
        "upgrade_year"
      ],
      "type": "object"
    },
    "NationalisationSettings": {
      "additionalProperties": false,
      "description": "Nationalisation and privatisation (R12, §9.1).",
      "properties": {
        "buyout_ratio": {
          "description": "Buy-out price on nationalisation, as a share of book value (default 1.0). Book value is\nwhat the holder paid for the utility at auction: utilities don't wear, like buildings\n(R41).",
          "type": "number"
        }
      },
      "required": [
        "buyout_ratio"
      ],
      "type": "object"
    },
    "UtilityRates": {
      "additionalProperties": false,
      "description": "A rate per utility.",
      "properties": {
        "electricity": {
          "description": "Electricity.",
          "type": "number"
        },
        "gas": {
          "description": "Gas.",
          "type": "number"
        },
        "telecoms": {
          "description": "Telephone exchange, later the internet.",
          "type": "number"
        },
        "water": {
          "description": "Water.",
          "type": "number"
        }
      },
      "required": [
        "electricity",
        "gas",
        "water",
        "telecoms"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Root of `utilities.yaml`.",
  "properties": {
    "internet": {
      "$ref": "#/$defs/InternetSettings",
      "description": "The telephone exchange's upgrade to the internet (R11)."
    },
    "nationalisation": {
      "$ref": "#/$defs/NationalisationSettings",
      "description": "Elections and ownership (R12)."
    },
    "reserve_prices": {
      "$ref": "#/$defs/UtilityRates",
      "description": "Minimum opening bid for each utility at auction, like a block's land base price (R12,\nR23)."
    }
  },
  "required": [
    "internet",
    "nationalisation",
    "reserve_prices"
  ],
  "title": "UtilitiesConfig",
  "type": "object"
}
